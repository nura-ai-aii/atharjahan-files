PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/personal_cloud_explorer?retryWrites=true&w=majority
ADMIN_PASSWORD=mySecurePassword123
JWT_SECRET=superSecretJwtKeyForPersonalCloudExplorer2026
JWT_EXPIRY_HOURS=24
UPLOAD_LIMIT_MB=2000

# Cloudflare R2 / AWS S3 Object Storage Configuration
CLOUD_STORAGE_PROVIDER=r2
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=personal-cloud-explorer-vault
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_REGION=auto
